#type vertex
#version 460 core

layout(location = 0) in vec3 aPos;
layout(location = 1) in vec2 aTexCoord;
layout(location = 2) in vec4 aColor;

out vec2 TexCoord;
out vec4 Color;

uniform mat4 uModel;
uniform mat4 uView;
uniform mat4 uProj;

void main() {
    gl_Position = uProj * uView * uModel * vec4(aPos, 1.0);
    TexCoord = aTexCoord;
    Color = aColor;
}

#type fragment
#version 460 core
#extension GL_ARB_bindless_texture : require

in vec2 TexCoord;
in vec4 Color;
out vec4 FragColor;

layout(bindless_sampler) uniform sampler2D uFontAtlas;
uniform vec4 uColor;

void main() {
    float alpha = texture(uFontAtlas, TexCoord).r;
    FragColor = vec4(Color.rgb * uColor.rgb, alpha * Color.a * uColor.a);
}
