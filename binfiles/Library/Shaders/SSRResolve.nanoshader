#type vertex
#version 460 core

layout(location = 0) in vec2 aPos;
layout(location = 1) in vec2 aUV;

out vec2 vUV;

void main() {
    vUV = aUV;
    gl_Position = vec4(aPos, 0.0, 1.0);
}

#type fragment
#version 460 core

in vec2 vUV;
out vec4 FragColor;

uniform sampler2D u_SSRRaw;
uniform sampler2D u_Depth;
uniform sampler2D u_Normal;
uniform sampler2D u_Roughness;

uniform mat4 u_InvProj;
uniform mat4 u_View;
uniform int u_ResolveTapCount;

uniform float u_Intensity;
uniform float u_RoughnessCutoff;
uniform float u_FresnelPower;

vec3 ReconstructViewPos(vec2 uv, float depth) {
    float z = depth * 2.0 - 1.0;
    vec4 clip = vec4(uv * 2.0 - 1.0, z, 1.0);
    vec4 view = u_InvProj * clip;
    return view.xyz / max(view.w, 1e-6);
}

void main() {
    float centerDepth = texture(u_Depth, vUV).r;
    if (centerDepth >= 1.0) {
        FragColor = vec4(0.0);
        return;
    }

    vec3 normalWS = normalize(texture(u_Normal, vUV).xyz * 2.0 - 1.0);
    vec3 normalVS = normalize((u_View * vec4(normalWS, 0.0)).xyz);
    vec3 viewPos = ReconstructViewPos(vUV, centerDepth);
    vec3 viewDir = normalize(-viewPos);

    float roughness = clamp(texture(u_Roughness, vUV).r, 0.0, 1.0);
    if (roughness >= u_RoughnessCutoff) {
        FragColor = vec4(0.0);
        return;
    }

    ivec2 rawSize = textureSize(u_SSRRaw, 0);
    ivec2 centerRaw = ivec2(clamp(floor(vUV * vec2(rawSize)), vec2(0.0), vec2(rawSize - 1)));
    vec4 centerSSR = texelFetch(u_SSRRaw, centerRaw, 0);
    const float validThreshold = 0.05;

    vec3 reflection = vec3(0.0);
    float reflectionValidity = 0.0;

    if (centerSSR.a > validThreshold) {
        reflection = centerSSR.rgb;
        reflectionValidity = centerSSR.a;
    } else {
        vec3 accum = vec3(0.0);
        float accumW = 0.0;
        float maxTapW = 0.0;

        vec2 taps[8] = vec2[](
            vec2(1.0, 0.0),
            vec2(-1.0, 0.0),
            vec2(0.0, 1.0),
            vec2(0.0, -1.0),
            vec2(1.0, 1.0),
            vec2(-1.0, 1.0),
            vec2(1.0, -1.0),
            vec2(-1.0, -1.0)
        );

        int tapCount = (u_ResolveTapCount >= 8) ? 8 : 4;
        for (int i = 0; i < tapCount; ++i) {
            ivec2 tapRaw = clamp(centerRaw + ivec2(taps[i]), ivec2(0), rawSize - ivec2(1));
            vec2 uv = (vec2(tapRaw) + vec2(0.5)) / vec2(rawSize);
            vec4 ssrTap = texelFetch(u_SSRRaw, tapRaw, 0);
            if (ssrTap.a <= validThreshold) continue;

            float tapDepth = texture(u_Depth, uv).r;
            if (tapDepth >= 1.0) continue;

            vec3 tapViewPos = ReconstructViewPos(uv, tapDepth);
            float depthDelta = abs(tapViewPos.z - viewPos.z);
            float depthW = 1.0 - smoothstep(0.005, 0.08, depthDelta);

            vec3 tapNormalWS = normalize(texture(u_Normal, uv).xyz * 2.0 - 1.0);
            vec3 tapNormalVS = normalize((u_View * vec4(tapNormalWS, 0.0)).xyz);
            float normalW = pow(max(dot(tapNormalVS, normalVS), 0.0), 4.0);

            float w = ssrTap.a * depthW * normalW;
            if (w <= 0.0) continue;

            accum += ssrTap.rgb * w;
            accumW += w;
            maxTapW = max(maxTapW, w);
        }

        if (accumW > 1e-4) {
            reflection = accum / accumW;
            reflectionValidity = clamp(maxTapW, 0.0, 1.0);
        }
    }

    float roughnessFactor = clamp((u_RoughnessCutoff - roughness) / max(u_RoughnessCutoff, 1e-4), 0.0, 1.0);
    float fresnel = pow(clamp(1.0 - max(dot(normalVS, viewDir), 0.0), 0.0, 1.0), u_FresnelPower);
    float reflectionWeight = clamp(u_Intensity * roughnessFactor * fresnel, 0.0, 1.0);

    // True misses should not add reflection energy.
    float contributionWeight = reflectionWeight * reflectionValidity;
    FragColor = vec4(reflection * contributionWeight, contributionWeight);
}
