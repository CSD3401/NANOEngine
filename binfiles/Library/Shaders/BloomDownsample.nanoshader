#type vertex
#version 460 core

layout(location = 0) in vec2 aPos;
layout(location = 1) in vec2 aUV;

out vec2 vUV;

void main()
{
    vUV = aUV;
    gl_Position = vec4(aPos, 0.0, 1.0);
}

#type fragment
#version 460 core

in vec2 vUV;
out vec4 FragColor;

uniform sampler2D u_Source;
uniform vec2      u_TexelSize;
uniform float     u_FilterRadius;

uniform int       u_ApplyThreshold;
uniform float     u_Threshold;
uniform float     u_SoftKnee;
uniform float     u_Scale;
uniform float     u_FireflyStrength;

float Luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 Prefilter(vec3 c) {
    if (u_ApplyThreshold == 0) return c;

    float l = max(Luminance(c), 0.0);
    float t = max(u_Threshold, 0.0);
    float knee = t * clamp(u_SoftKnee, 0.0, 1.0);

    float soft = l - t + knee;
    soft = clamp(soft, 0.0, 2.0 * knee);
    soft = (soft * soft) / (4.0 * knee + 1e-5);

    float contrib = max(l - t, 0.0) + soft;
    float w = contrib / max(l, 1e-4);
    return c * (w * u_Scale);
}

void main()
{
    vec2 o = u_TexelSize * u_FilterRadius;

    vec3 sum = vec3(0.0);
    float wsum = 0.0;

    float fireflyStrength = (u_ApplyThreshold == 1) ? max(u_FireflyStrength, 0.0) : 0.0;

    if (u_ApplyThreshold == 1) {
        // Higher-quality 9-tap tent for level 0 (scene -> bloom0) to reduce shimmer.
        // Weights: [1 2 1; 2 4 2; 1 2 1] / 16
        vec2 offsets[9] = vec2[9](
            vec2(-1.0, -1.0), vec2( 0.0, -1.0), vec2( 1.0, -1.0),
            vec2(-1.0,  0.0), vec2( 0.0,  0.0), vec2( 1.0,  0.0),
            vec2(-1.0,  1.0), vec2( 0.0,  1.0), vec2( 1.0,  1.0)
        );
        float kernel[9] = float[9](
            1.0, 2.0, 1.0,
            2.0, 4.0, 2.0,
            1.0, 2.0, 1.0
        );

        for (int i = 0; i < 9; ++i) {
            vec3 raw = texture(u_Source, vUV + o * offsets[i]).rgb;
            float rawL = max(Luminance(raw), 0.0);
            vec3 c = Prefilter(raw);

            float fw = 1.0;
            if (fireflyStrength > 0.0) {
                fw = 1.0 / (1.0 + rawL * fireflyStrength);
            }

            float w = (kernel[i] / 16.0) * fw;
            sum += c * w;
            wsum += w;
        }
    }
    else {
        // Fast 5-tap for subsequent mips.
        vec2 offsets[5] = vec2[5](
            vec2( 0.0,  0.0),
            vec2( 1.0,  1.0),
            vec2(-1.0,  1.0),
            vec2( 1.0, -1.0),
            vec2(-1.0, -1.0)
        );
        float kernel[5] = float[5](0.5, 0.125, 0.125, 0.125, 0.125);

        for (int i = 0; i < 5; ++i) {
            vec3 raw = texture(u_Source, vUV + o * offsets[i]).rgb;
            float rawL = max(Luminance(raw), 0.0);
            vec3 c = Prefilter(raw);

            float fw = 1.0;
            if (fireflyStrength > 0.0) {
                fw = 1.0 / (1.0 + rawL * fireflyStrength);
            }

            float w = kernel[i] * fw;
            sum += c * w;
            wsum += w;
        }
    }

    vec3 outC = sum / max(wsum, 1e-4);
    FragColor = vec4(outC, 1.0);
}
