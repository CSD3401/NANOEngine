#type vertex
#version 460 core

layout(location = 0) in vec3 aPos;
layout(location = 2) in vec2 a_TexCoord;

// Particle instance data (your EnableParticleInstanceLayout(10,11,12))
layout(location = 10) in vec3  i_PosLS;
layout(location = 11) in float i_Size;
layout(location = 12) in vec4  i_Color;

uniform mat4 u_View;
uniform mat4 u_Projection;

// Choice B: emitter transform
uniform mat4 u_EmitterModel;

// Billboard basis (world space)
uniform vec3 u_CamRightWS;
uniform vec3 u_CamUpWS;

out vec2 v_UV;
out vec4 v_Color;

void main()
{
    // particle center in world space
    vec3 centerWS = (u_EmitterModel * vec4(i_PosLS, 1.0)).xyz;

    // quad corners from mesh positions (-0.5..0.5)
    vec2 corner = aPos.xy;

    vec3 offsetWS = (corner.x * u_CamRightWS + corner.y * u_CamUpWS) * i_Size;
    vec3 posWS = centerWS + offsetWS;

    gl_Position = u_Projection * u_View * vec4(posWS, 1.0);

    v_UV = a_TexCoord;
    v_Color = i_Color;
}

#type fragment
#version 460 core

in vec2 v_UV;
in vec4 v_Color;

layout(location = 0) out vec4 FragColor;
// If you don't want particles to write picking IDs, omit this output from the particle pipeline.
// layout(location = 1) out vec4 OutID;

uniform sampler2D u_AlbedoMap;
uniform int       u_HasAlbedoMap;

uniform float     u_Opacity;     // default 1.0
uniform int       u_AlphaClip;   // 0/1
uniform float     u_AlphaCutoff; // e.g. 0.5

void main()
{
    vec4 tex = vec4(1.0);
    if (u_HasAlbedoMap != 0) {
        tex = texture(u_AlbedoMap, v_UV);
    }

    vec4 col = tex * v_Color;
    col.a *= clamp(u_Opacity, 0.0, 1.0);

    if (u_AlphaClip != 0 && col.a < u_AlphaCutoff)
        discard;

    FragColor = col;

    // OutID = vec4(-1.0, -1.0, -1.0, 1.0); // if MRT requires it; otherwise remove output
}