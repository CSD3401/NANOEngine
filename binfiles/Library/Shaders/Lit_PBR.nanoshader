#type vertex
#version 460 core

layout(location = 0) in vec3 aPos;
layout(location = 1) in vec3 a_Normal;
layout(location = 2) in vec2 a_TexCoord;

uniform mat4 u_Model;
uniform mat4 u_View;
uniform mat4 u_Projection;
uniform mat4 u_NormalMatrix; // assumed to be inverse-transpose(model)

out vec3 v_Normal;
out vec3 v_FragPos;
out vec2 v_TexCoord;

void main() {
    vec4 world = u_Model * vec4(aPos, 1.0);
    v_FragPos = world.xyz;
    v_Normal  = mat3(u_NormalMatrix) * a_Normal;
    v_TexCoord = a_TexCoord;
    gl_Position = u_Projection * u_View * world;
}


#type fragment
#version 460 core

in vec3 v_Normal;
in vec3 v_FragPos;
in vec2 v_TexCoord;

out vec4 FragColor;


// ---------- Common material & light defs ----------
const int MAX_LIGHTS = 16;

struct Light {
    int   type;          // 0 = Directional, 1 = Point, 2 = Spot
    vec3  color;         // RGB energy
    float intensity;     // scalar multiplier

    vec3  position;      // for point/spot
    float range;         // not used but available

    vec3  direction;     // for dir/spot (point to -Z of light)
    float innerCutoff;   // cos(theta) for spot inner
    float outerCutoff;   // cos(theta) for spot outer

    // attenuation (point/spot)
    float constantAtt;
    float linearAtt;
    float quadAtt;
    float pad0;
};

layout(std140, binding = 0) uniform LightingData {
    int   u_numLights;
    vec3  u_CamPos;
    // padding to 16-byte alignment occurs automatically in std140
};

uniform Light u_lights[MAX_LIGHTS];

// material inputs (kept minimal & generic)
uniform vec3  u_BaseColor  = vec3(1.0);
uniform float u_Metallic   = 0.0;  // used by PBR only
uniform float u_Roughness  = 0.5;  // used by PBR only
uniform float u_Shininess  = 32.0; // used by Blinn-Phong only
uniform float u_AmbientIntensity = 0.06;

uniform sampler2D u_AlbedoTex;
uniform int       u_HasAlbedo = 0;


// ---------- PBR helpers (GGX/Trowbridge-Reitz + Schlick Fresnel + Smith G) ----------
float saturate(float x) { return clamp(x, 0.0, 1.0); }
vec3  saturate(vec3 v)  { return clamp(v, 0.0, 1.0); }

float D_GGX(float NoH, float roughness) {
    float a  = roughness * roughness;
    float a2 = a * a;
    float d  = (NoH * NoH) * (a2 - 1.0) + 1.0;
    return a2 / max(1e-5, (3.14159265 * d * d));
}

float V_SmithGGXCorrelated(float NoV, float NoL, float roughness) {
    float a  = roughness * roughness;
    float a2 = a * a;
    float gv = NoL * sqrt((-NoV * a2 + NoV) * NoV + a2);
    float gl = NoV * sqrt((-NoL * a2 + NoL) * NoL + a2);
    return 0.5 / max(1e-5, gv + gl);
}

vec3  F_Schlick(vec3 F0, float VoH) {
    return F0 + (1.0 - F0) * pow(1.0 - VoH, 5.0);
}

float lightAttenuation(Light L, vec3 fragPos) {
    if (L.type == 0) return 1.0; // directional
    float d = length(L.position - fragPos);
    return 1.0 / (L.constantAtt + L.linearAtt * d + L.quadAtt * d * d);
}

float spotFactor(Light L, vec3 lightDir) {
    if (L.type != 2) return 1.0;
    float c = dot(normalize(-L.direction), normalize(lightDir));
    float t = clamp((c - L.outerCutoff) / max(1e-4, (L.innerCutoff - L.outerCutoff)), 0.0, 1.0);
    return t;
}

void main() {
    vec3 N = normalize(v_Normal);
    vec3 V = normalize(u_CamPos - v_FragPos);
    vec3 albedo = (u_HasAlbedo == 1) ? pow(texture(u_AlbedoTex, v_TexCoord).rgb, vec3(2.2)) : pow(u_BaseColor, vec3(2.2)); // linearize if coming from sRGB
    float metallic  = clamp(u_Metallic, 0.0, 1.0);
    float roughness = clamp(u_Roughness, 0.04, 1.0);

    // compute F0
    vec3 F0 = mix(vec3(0.04), albedo, metallic);

    vec3 Lo = vec3(0.0);

    for (int i = 0; i < u_numLights && i < MAX_LIGHTS; ++i) {
        Light L = u_lights[i];
        vec3 Ldir = (L.type == 0) ? normalize(-L.direction) : normalize(L.position - v_FragPos);
        float NoL = max(dot(N, Ldir), 0.0);
        if (NoL <= 0.0) continue;

        vec3 H  = normalize(V + Ldir);
        float NoV = max(dot(N, V), 0.0);
        float NoH = max(dot(N, H), 0.0);
        float VoH = max(dot(V, H), 0.0);

        float att = lightAttenuation(L, v_FragPos) * spotFactor(L, Ldir);
        vec3 radiance = L.color * L.intensity * att;

        float  D = D_GGX(NoH, roughness);
        float  Vg = V_SmithGGXCorrelated(NoV, NoL, roughness);
        vec3   F = F_Schlick(F0, VoH);

        vec3  spec = (D * Vg) * F;

        // energy conservation: split albedo into diffuse/specular based on metallic
        vec3 kd = (1.0 - F) * (1.0 - metallic);

        vec3 diffuse = kd * albedo / 3.14159265;

        Lo += (diffuse + spec) * radiance * NoL;
    }

    // simple ambient term (use IBL if available)
    vec3 ambient = albedo * u_AmbientIntensity;

    vec3 color = ambient + Lo;

    // tone map + gamma
    color = color / (color + vec3(1.0));
    color = pow(color, vec3(1.0/2.2));

    FragColor = vec4(color, 1.0);
}
