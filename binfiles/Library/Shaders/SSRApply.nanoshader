#type vertex
#version 460 core

layout(location = 0) in vec2 aPos;
layout(location = 1) in vec2 aUV;

out vec2 vUV;

void main() {
    vUV = aUV;
    gl_Position = vec4(aPos, 0.0, 1.0);
}

#type fragment
#version 460 core

in vec2 vUV;
out vec4 FragColor;

uniform sampler2D u_SceneColor;
uniform sampler2D u_SSRContribution;

void main() {
    vec3 scene = texture(u_SceneColor, vUV).rgb;
    vec3 ssr = texture(u_SSRContribution, vUV).rgb;
    FragColor = vec4(scene + ssr, 1.0);
}
