#type vertex
#version 460 core

// Per-vertex attributes (matches UIVertex2 layout)
layout(location = 0) in vec3 aPos;      // Position (Vec3)
layout(location = 1) in vec2 aTexCoord; // TexCoord (Vec2)
layout(location = 2) in vec4 aColor;    // Color (Vec4)

out vec2 vUV;
out vec4 vColor;

uniform vec2 uScreenSize;

void main() {
    // Convert pixel coordinates to NDC (-1 to 1)
    float ndcX = (aPos.x / uScreenSize.x) * 2.0 - 1.0;
    float ndcY = 1.0 - (aPos.y / uScreenSize.y) * 2.0;

    gl_Position = vec4(ndcX, ndcY, aPos.z, 1.0);
    vUV = aTexCoord;
    vColor = aColor;
}

#type fragment
#version 460 core
#extension GL_ARB_bindless_texture : require

in vec2 vUV;
in vec4 vColor;
out vec4 FragColor;

uniform vec4 uColor;
uniform int uHasTexture;
layout(bindless_sampler) uniform sampler2D uTexture;

void main() {
    // Unity-style: Texture x Vertex Color x Uniform Color
    vec4 color = vColor * uColor;

    if (uHasTexture == 1) {
        FragColor = texture(uTexture, vUV) * color;
    } else {
        FragColor = color;
    }
}
