#type vertex
#version 460 core

layout(location = 0) in vec2 aPos;
layout(location = 1) in vec2 aUV;

out vec2 vUV;

void main() {
    vUV = aUV;
    gl_Position = vec4(aPos, 0.0, 1.0);
}

#type fragment
#version 460 core

in vec2 vUV;
out vec4 FragColor;

uniform sampler2D u_CurrentColor;
uniform sampler2D u_CurrentDepth;
uniform sampler2D u_History;

uniform mat4 u_CurrViewProjInv;
uniform mat4 u_PrevViewProj;

uniform vec2 u_TexelSize;
uniform float u_FeedbackMin;
uniform float u_FeedbackMax;
uniform float u_Sharpen;
uniform int u_HasHistory;

vec3 SampleNeighborhoodMin(vec2 uv) {
    vec3 minC = vec3(1e9);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 tapUV = uv + vec2(float(x), float(y)) * u_TexelSize;
            vec3 c = texture(u_CurrentColor, tapUV).rgb;
            minC = min(minC, c);
        }
    }
    return minC;
}

vec3 SampleNeighborhoodMax(vec2 uv) {
    vec3 maxC = vec3(-1e9);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 tapUV = uv + vec2(float(x), float(y)) * u_TexelSize;
            vec3 c = texture(u_CurrentColor, tapUV).rgb;
            maxC = max(maxC, c);
        }
    }
    return maxC;
}

vec3 SampleNeighborhoodAverage(vec2 uv) {
    vec3 sum = vec3(0.0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 tapUV = uv + vec2(float(x), float(y)) * u_TexelSize;
            sum += texture(u_CurrentColor, tapUV).rgb;
        }
    }
    return sum / 9.0;
}

bool ReprojectToPrevUV(vec2 uv, out vec2 prevUV) {
    float depth = texture(u_CurrentDepth, uv).r;
    if (depth >= 1.0) {
        return false;
    }

    vec4 currClip = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 world = u_CurrViewProjInv * currClip;
    if (abs(world.w) < 1e-5) {
        return false;
    }
    world.xyz /= world.w;

    vec4 prevClip = u_PrevViewProj * vec4(world.xyz, 1.0);
    if (abs(prevClip.w) < 1e-5) {
        return false;
    }

    vec3 prevNdc = prevClip.xyz / prevClip.w;
    prevUV = prevNdc.xy * 0.5 + 0.5;

    return prevUV.x >= 0.0 && prevUV.x <= 1.0 && prevUV.y >= 0.0 && prevUV.y <= 1.0;
}

void main() {
    vec3 current = texture(u_CurrentColor, vUV).rgb;

    if (u_HasHistory == 0) {
        FragColor = vec4(current, 1.0);
        return;
    }

    vec2 prevUV;
    if (!ReprojectToPrevUV(vUV, prevUV)) {
        FragColor = vec4(current, 1.0);
        return;
    }

    vec3 history = texture(u_History, prevUV).rgb;
    vec3 minC = SampleNeighborhoodMin(vUV);
    vec3 maxC = SampleNeighborhoodMax(vUV);
    vec3 neighborhoodAvg = SampleNeighborhoodAverage(vUV);

    history = clamp(history, minC, maxC);

    float motion = length(prevUV - vUV);
    float feedbackLerp = clamp(motion * 64.0, 0.0, 1.0);
    float historyWeight = mix(u_FeedbackMax, u_FeedbackMin, feedbackLerp);
    historyWeight = clamp(historyWeight, 0.0, 0.99);

    vec3 resolved = mix(current, history, historyWeight);

    if (u_Sharpen > 0.0) {
        vec3 detail = resolved - neighborhoodAvg;
        resolved += detail * u_Sharpen;
    }

    FragColor = vec4(max(resolved, vec3(0.0)), 1.0);
}
