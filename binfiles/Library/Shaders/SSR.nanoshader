#type vertex
#version 460 core

layout(location = 0) in vec2 aPos;
layout(location = 1) in vec2 aUV;

out vec2 vUV;

void main() {
    vUV = aUV;
    gl_Position = vec4(aPos, 0.0, 1.0);
}

#type fragment
#version 460 core

in vec2 vUV;
out vec4 FragColor;

uniform sampler2D u_SceneColor;
uniform sampler2D u_Depth;
uniform sampler2D u_Normal;
uniform sampler2D u_Roughness;

uniform mat4 u_InvProj;
uniform mat4 u_Proj;
uniform mat4 u_View;

uniform vec2 u_TexelSize;

uniform float u_Intensity;
uniform float u_MaxDistance;
uniform float u_Thickness;
uniform int u_MaxSteps;
uniform float u_Stride;
uniform int u_BinarySearchSteps;
uniform float u_RoughnessCutoff;
uniform float u_FresnelPower;
uniform float u_EdgeFade;
uniform float u_MaxSceneMip;

vec3 ReconstructViewPos(vec2 uv, float depth) {
    float z = depth * 2.0 - 1.0;
    vec4 clip = vec4(uv * 2.0 - 1.0, z, 1.0);
    vec4 view = u_InvProj * clip;
    return view.xyz / max(view.w, 1e-6);
}

vec2 ProjectToUV(vec3 viewPos) {
    vec4 clip = u_Proj * vec4(viewPos, 1.0);
    vec2 ndc = clip.xy / max(clip.w, 1e-6);
    return ndc * 0.5 + 0.5;
}

float ComputeEdgeFade(vec2 uv) {
    float edgeDist = min(min(uv.x, uv.y), min(1.0 - uv.x, 1.0 - uv.y));
    return clamp(edgeDist / max(u_EdgeFade, 1e-4), 0.0, 1.0);
}

void main() {
    float centerDepth = texture(u_Depth, vUV).r;
    if (centerDepth >= 1.0) {
        FragColor = vec4(0.0);
        return;
    }

    float roughness = clamp(texture(u_Roughness, vUV).r, 0.0, 1.0);
    if (roughness >= u_RoughnessCutoff) {
        FragColor = vec4(0.0);
        return;
    }

    vec3 normalWS = normalize(texture(u_Normal, vUV).xyz * 2.0 - 1.0);
    vec3 normalVS = normalize((u_View * vec4(normalWS, 0.0)).xyz);
    vec3 viewPos = ReconstructViewPos(vUV, centerDepth);
    vec3 viewDir = normalize(-viewPos);
    vec3 reflDir = normalize(reflect(-viewDir, normalVS));
    if (reflDir.z >= -1e-4) {
        FragColor = vec4(0.0);
        return;
    }

    float ndv = max(dot(normalVS, viewDir), 0.0);
    float stepStride = max(u_Stride * mix(0.25, 1.0, ndv), 1e-3);
    float maxDist = max(u_MaxDistance * mix(1.0, 0.3, roughness), 1e-3);
    vec3 currPos = viewPos;
    vec3 prevPos = currPos;
    vec2 hitUV = vec2(-1.0);
    vec3 hitPos = vec3(0.0);
    bool hit = false;
    float prevDelta = 0.0;
    bool hasPrevSample = false;
    float hitTravel = 0.0;

    for (int i = 0; i < 256; ++i) {
        if (i >= u_MaxSteps) break;

        prevPos = currPos;
        currPos += reflDir * stepStride;

        float traveled = length(currPos - viewPos);
        if (traveled > maxDist) break;

        vec2 uv = ProjectToUV(currPos);
        if (uv.x <= 0.0 || uv.x >= 1.0 || uv.y <= 0.0 || uv.y >= 1.0) break;

        float sampleDepth = texture(u_Depth, uv).r;
        if (sampleDepth >= 1.0) continue;

        vec3 sampleViewPos = ReconstructViewPos(uv, sampleDepth);
        // Signed depth delta in view-space:
        // delta > 0 means the marched ray is behind scene geometry at this UV.
        float delta = sampleViewPos.z - currPos.z;
        float thickness = u_Thickness * (1.0 + 0.1 * max(-currPos.z, 0.0));
        bool crossed = hasPrevSample && (prevDelta <= 0.0) && (delta >= 0.0);
        bool withinThickness = delta >= 0.0 && delta <= thickness;

        if (crossed || withinThickness) {
            vec3 lo = prevPos;
            vec3 hi = currPos;
            vec2 finalUV = uv;
            for (int j = 0; j < 16; ++j) {
                if (j >= u_BinarySearchSteps) break;
                vec3 mid = mix(lo, hi, 0.5);
                vec2 midUV = ProjectToUV(mid);
                if (midUV.x <= 0.0 || midUV.x >= 1.0 || midUV.y <= 0.0 || midUV.y >= 1.0) {
                    hi = mid;
                    continue;
                }

                float midDepth = texture(u_Depth, midUV).r;
                if (midDepth >= 1.0) {
                    lo = mid;
                    continue;
                }
                vec3 midScenePos = ReconstructViewPos(midUV, midDepth);
                float midDelta = midScenePos.z - mid.z;
                if (midDelta >= 0.0) {
                    hi = mid;
                    finalUV = midUV;
                } else {
                    lo = mid;
                }
            }

            hitUV = finalUV;
            hitPos = hi;
            hitTravel = traveled;
            hit = true;
            break;
        }

        prevDelta = delta;
        hasPrevSample = true;
    }

    if (!hit || hitUV.x <= 0.0 || hitUV.x >= 1.0 || hitUV.y <= 0.0 || hitUV.y >= 1.0) {
        FragColor = vec4(0.0);
        return;
    }

    vec3 hitNormalWS = normalize(texture(u_Normal, hitUV).xyz * 2.0 - 1.0);
    vec3 hitNormalVS = normalize((u_View * vec4(hitNormalWS, 0.0)).xyz);
    float nDotR = dot(hitNormalVS, -reflDir);
    if (nDotR < 0.02) {
        FragColor = vec4(0.0);
        return;
    }
    float normalConfidence = smoothstep(0.05, 0.35, nDotR);

    float depthAtHit = texture(u_Depth, hitUV).r;
    if (depthAtHit >= 1.0) {
        FragColor = vec4(0.0);
        return;
    }
    vec3 scenePosAtHit = ReconstructViewPos(hitUV, depthAtHit);
    float hitThickness = u_Thickness * (1.0 + 0.1 * max(-hitPos.z, 0.0));
    float depthDeltaAtHit = abs(scenePosAtHit.z - hitPos.z);
    if (depthDeltaAtHit > max(hitThickness * 3.5, 0.05)) {
        FragColor = vec4(0.0);
        return;
    }
    float depthConfidence = 1.0 - smoothstep(
        max(hitThickness, 0.002),
        max(hitThickness * 2.5, 0.02),
        depthDeltaAtHit
    );

    float maxSceneMip = max(u_MaxSceneMip, 0.0);
    float lod = clamp(roughness * maxSceneMip, 0.0, maxSceneMip);
    vec3 reflected = textureLod(u_SceneColor, hitUV, lod).rgb;

    float edge = min(ComputeEdgeFade(vUV), ComputeEdgeFade(hitUV));
    float safeMaxDistance = max(maxDist, 1e-3);
    float distConfidence = 1.0 - smoothstep(safeMaxDistance * 0.85, safeMaxDistance, hitTravel);
    float validity = clamp(normalConfidence * depthConfidence * edge * distConfidence, 0.0, 1.0);

    FragColor = vec4(reflected, validity);
}
