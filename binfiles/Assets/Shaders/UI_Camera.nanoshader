#type vertex
#version 460 core

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aUV;

uniform vec2 uScreenSize;
uniform mat4 uView;
uniform mat4 uProj;
uniform float uPlaneDistance;

out vec2 vUV;

void main() {
    // Convert pixel coords to NDC
    float ndcX = (aPos.x / uScreenSize.x) * 2.0 - 1.0;
    float ndcY = 1.0 - (aPos.y / uScreenSize.y) * 2.0;
    
    // Place at distance from camera in view space
    vec4 viewPos = vec4(ndcX * uPlaneDistance, ndcY * uPlaneDistance, 
                        -uPlaneDistance, 1.0);
    
    gl_Position = uProj * viewPos;
    vUV = aUV;
}

#type fragment
#version 460 core
#extension GL_ARB_bindless_texture : require

in vec2 vUV;
out vec4 FragColor;

uniform vec4 uColor;
uniform sampler2D u_BaseMap;
uniform int u_HasBaseMap;

void main() {
    vec4 color = uColor;
    
    if (u_HasBaseMap != 0) {
        color *= texture(u_BaseMap, vUV);
    }
    
    FragColor = color;
}