#type vertex
#version 460 core

layout(location = 0) in vec3 aPos;
layout(location = 1) in vec3 a_Normal;
layout(location = 2) in vec2 a_TexCoord;
layout(location = 5) in mat4 i_Model;   // per-instance model matrix (divisor=1)
layout(location = 9) in vec3 i_IDRGB;   // per-instance picking ID (0..1)

uniform mat4 u_View;
uniform mat4 u_Projection;

out vec3 v_Normal;
out vec3 v_FragPos;
out vec2 v_TexCoord;
out vec3 v_ID;

void main() {
    vec4 world = i_Model * vec4(aPos, 1.0);
    v_FragPos = world.xyz;

    // robust normal for non-uniform scale
    mat3 normalMtx = transpose(inverse(mat3(i_Model)));
    v_Normal  = normalMtx * a_Normal;

    v_TexCoord = a_TexCoord;
    v_ID = i_IDRGB;

    gl_Position = u_Projection * u_View * world;
}


#type fragment
#version 460 core
#extension GL_ARB_bindless_texture : require

#define MAX_LIGHTS 12
#define LIGHT_TYPE_DIRECTIONAL 0
#define LIGHT_TYPE_POINT 1
#define LIGHT_TYPE_SPOT 2

in vec3 v_Normal;
in vec3 v_FragPos;
in vec2 v_TexCoord;
in vec3 v_ID;

layout(location = 0) out vec4 FragColor;
layout(location = 1) out vec4 OutID;

// ===== Scene / Lighting =====
uniform vec3 u_CameraPos;
uniform vec3 u_AmbientColor;

// Base (albedo)
uniform vec3      u_BaseColor;
uniform sampler2D u_AlbedoMap;
uniform int       u_HasAlbedoMap;

// Normal (BC5 packed X,Y)
uniform sampler2D u_NormalMap;
uniform int       u_HasNormalMap;

// Roughness / Metallic
uniform float     u_Roughness;
uniform sampler2D u_RoughnessMap;
uniform int       u_HasRoughnessMap;

uniform float     u_Metallic;
uniform sampler2D u_MetallicMap;
uniform int       u_HasMetallicMap;

// Ambient Occlusion
uniform float     u_AmbientOcclusion;
uniform sampler2D u_AmbientOcclusionMap;
uniform int       u_HasAOMap;

// UV Transform
uniform vec3 u_Tiling;  // uses .xy
uniform vec3 u_Offset;  // uses .xy

// Emissive
uniform vec3      u_Emissive;

// ===== Lights =====
struct Light {
    int   type; // 0 = directional, 1 = point, 2 = spot
    vec3  color;
    float intensity;

    vec3  position;
    vec3  direction;

    float constant;
    float linear;
    float quadratic;

    float innerCutoff;    // cos(innerAngle)
    float outerCutoff;    // cos(outerAngle)
};
uniform int   u_numLights;
uniform Light u_lights[MAX_LIGHTS];

// ===== Fog (scene-wide) =====
uniform int   u_FogEnabled;   // 0/1
uniform vec3  u_FogColor;     // linear color!
uniform int   u_FogMode;      // 0=Linear, 1=Exp, 2=Exp2
uniform float u_FogDensity;   // Exp/Exp2
uniform float u_FogStart;     // Linear
uniform float u_FogEnd;       // Linear

const float PI = 3.14159265359;

// ---- helpers ----
vec3 srgb_to_linear(vec3 c){
    bvec3 cutoff = lessThanEqual(c, vec3(0.04045));
    vec3 low  = c / 12.92;
    vec3 high = pow((c + 0.055) / 1.055, vec3(2.4));
    return mix(high, low, vec3(cutoff));
}
vec3 linear_to_srgb(vec3 c){
    bvec3 cutoff = lessThanEqual(c, vec3(0.0031308));
    vec3 low  = c * 12.92;
    vec3 high = 1.055 * pow(max(c, 0.0), vec3(1.0/2.4)) - 0.055;
    return clamp(mix(high, low, vec3(cutoff)), 0.0, 1.0);
}

float DistributionGGX(float NdotH, float rough){
    float a=max(rough,0.04); float a2=a*a;
    float denom=(NdotH*NdotH)*(a2-1.0)+1.0;
    return a2 / max(PI*denom*denom, 1e-6);
}
float GeometrySchlickGGX(float NdotX, float rough){
    float r=max(rough,0.04); float k=(r+1.0); k=(k*k)/8.0;
    return NdotX / max(NdotX*(1.0-k)+k, 1e-6);
}
float GeometrySmith(float NdotV,float NdotL,float rough){
    return GeometrySchlickGGX(NdotV,rough) * GeometrySchlickGGX(NdotL,rough);
}
vec3  FresnelSchlick(float cosTheta, vec3 F0){
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta,0.0,1.0), 5.0);
}

mat3 ComputeTBN(vec3 N, vec3 P, vec2 uv){
    vec3 dp1 = dFdx(P), dp2 = dFdy(P);
    vec2 duv1 = dFdx(uv), duv2 = dFdy(uv);
    vec3 T = normalize(dp1 * duv2.y - dp2 * duv1.y);
    vec3 B = normalize(cross(N, T));
    return mat3(T, B, N);
}

vec3 BRDF_GGX_Smith(vec3 N, vec3 V, vec3 L, vec3 albedo, float metallic, float rough){
    vec3 H = normalize(V + L);
    float NdotL = max(dot(N,L),0.0);
    float NdotV = max(dot(N,V),0.0);
    float NdotH = max(dot(N,H),0.0);
    float VdotH = max(dot(V,H),0.0);
    if (NdotL<=0.0 || NdotV<=0.0) return vec3(0.0);

    vec3 F0 = mix(vec3(0.04), albedo, metallic);
    float D = DistributionGGX(NdotH,rough);
    float G = GeometrySmith(NdotV,NdotL,rough);
    vec3  F = FresnelSchlick(VdotH, F0);

    vec3 spec = (D*G*F) / max(4.0*NdotV*NdotL, 1e-6);
    vec3 Ks = F;
    vec3 Kd = (1.0 - Ks) * (1.0 - metallic);
    vec3 diff = (Kd * albedo) / PI;
    return (diff + spec) * NdotL;
}
//fog
float FogFactor(float d){
    if (u_FogMode==0){ // Linear
        float denom = max(u_FogEnd - u_FogStart, 1e-4);
        return clamp((u_FogEnd - d) / denom, 0.0, 1.0);
    } else if (u_FogMode==1){ // Exp
        return clamp(exp(-u_FogDensity * d), 0.0, 1.0);
    } else { // Exp2
        float x = u_FogDensity * d;
        return clamp(exp(-x*x), 0.0, 1.0);
    }
}

// ---- light evaluators ----
vec3 EvalDirectional(in Light L, vec3 N, vec3 V, vec3 albedo, float metallic, float rough){
    vec3 Ld = normalize(-L.direction);
    vec3 brdf = BRDF_GGX_Smith(N,V,Ld,albedo,metallic,rough);
    return brdf * (L.color * L.intensity);
}
vec3 EvalPoint(in Light L, vec3 N, vec3 V, vec3 P, vec3 albedo, float metallic, float rough){
    vec3  Ldir = L.position - P;
    float dist2 = dot(Ldir,Ldir);
    float d = sqrt(dist2);
    if (d<=0.0) return vec3(0.0);
    vec3 Ld = Ldir / d;
    float atten = 1.0 / max(L.constant + L.linear*d + L.quadratic*dist2, 1e-6);
    vec3 brdf = BRDF_GGX_Smith(N,V,Ld,albedo,metallic,rough);
    return brdf * (L.color * L.intensity * atten);
}
vec3 EvalSpot(in Light L, vec3 N, vec3 V, vec3 P, vec3 albedo, float metallic, float rough){
    vec3  Ldir = L.position - P;
    float dist2 = dot(Ldir,Ldir);
    float d = sqrt(dist2);
    if (d<=0.0) return vec3(0.0);
    vec3 Ld = Ldir / d;

    float theta = dot(Ld, normalize(-L.direction));
    float eps = max(L.innerCutoff - L.outerCutoff, 1e-4);
    float spot = clamp((theta - L.outerCutoff) / eps, 0.0, 1.0);
    if (spot<=0.0) return vec3(0.0);

    float atten = 1.0 / max(L.constant + L.linear*d + L.quadratic*dist2, 1e-6);
    vec3 brdf = BRDF_GGX_Smith(N,V,Ld,albedo,metallic,rough);
    return brdf * (L.color * L.intensity * atten * spot);
}

void main() {
    // UV transform
    vec2 uv = v_TexCoord * u_Tiling.xy + u_Offset.xy;

    // view/normal
    vec3 V = normalize(u_CameraPos - v_FragPos);
    vec3 N = normalize(v_Normal);

    // Albedo (sRGB to linear)
    vec3 albedo = srgb_to_linear(clamp(u_BaseColor, 0.0, 1.0));
    if (u_HasAlbedoMap != 0){
        albedo *= srgb_to_linear(texture(u_AlbedoMap, uv).rgb);
    }

    // Normal map (BC5 XY)
    if (u_HasNormalMap != 0){
        vec2 enc = texture(u_NormalMap, uv).rg * 2.0 - 1.0;
        float z = sqrt(max(1.0 - dot(enc, enc), 0.0));
        vec3 n = vec3(enc, z);
        mat3 TBN = ComputeTBN(N, v_FragPos, uv);
        N = normalize(TBN * n);
    }

    // Roughness/Metallic
    float rough = clamp(u_Roughness, 0.04, 1.0);
    if (u_HasRoughnessMap != 0) rough = clamp(texture(u_RoughnessMap, uv).r, 0.04, 1.0);

    float metal = clamp(u_Metallic, 0.0, 1.0);
    if (u_HasMetallicMap  != 0) metal  = clamp(texture(u_MetallicMap,  uv).r, 0.0, 1.0);

    // Ambient Occlusion
    float ao = clamp(u_AmbientOcclusion, 0.0, 1.0);
    if (u_HasAOMap != 0) ao = clamp(texture(u_AmbientOcclusionMap, uv).r, 0.0, 1.0);

    // Lighting
    vec3 ambient = u_AmbientColor * albedo * ao;

    vec3 Lo = vec3(0.0);
    for (int i = 0; i < u_numLights; ++i){
        if (u_lights[i].type == LIGHT_TYPE_DIRECTIONAL) Lo += EvalDirectional(u_lights[i], N, V, albedo, metal, rough);
        else if (u_lights[i].type == LIGHT_TYPE_POINT)  Lo += EvalPoint      (u_lights[i], N, V, v_FragPos, albedo, metal, rough);
        else if (u_lights[i].type == LIGHT_TYPE_SPOT)   Lo += EvalSpot       (u_lights[i], N, V, v_FragPos, albedo, metal, rough);
    }

    vec3 color_linear = max(ambient + Lo + u_Emissive, 0.0);

    // Fog (linear space)
    if (u_FogEnabled == 1){
        float d  = distance(u_CameraPos, v_FragPos);
        float ff = FogFactor(d);
        color_linear = mix(u_FogColor, color_linear, ff);
    }

    vec3 color_srgb = linear_to_srgb(color_linear);
    FragColor = vec4(color_srgb, 1.0);

    // ID buffer for picking
    OutID = vec4(v_ID, 1.0);
}
