#type vertex
#version 460 core

layout(location = 0) in vec3 aPos;
layout(location = 1) in vec3 a_Normal; // not used for this
layout(location = 2) in vec2 a_TexCoord;
layout(location = 5) in mat4 i_Model;

uniform mat4 u_View;
uniform mat4 u_Projection;

out vec2 v_TexCoord;

void main() {
	vec4 world = i_Model * vec4(aPos, 1.0);
	gl_Position = u_Projection * u_View * world;
    v_TexCoord = a_TexCoord;
}

#type fragment
#version 460 core
#extension GL_ARB_bindless_texture : require

uniform sampler2D u_BaseMap;
uniform int u_HasBaseMap;
uniform vec3 u_BaseColor = vec3(1.0);

uniform vec3 u_Tiling = vec3(1.0, 1.0, 0.0);
uniform vec3 u_Offset = vec3(0.0, 0.0, 0.0);

in vec2 v_TexCoord;

out vec4 FragColor;

void main() {
	vec3 base = u_BaseColor;
	vec2 uv = v_TexCoord * u_Tiling.xy + u_Offset.xy;

	if (u_HasBaseMap != 0) {
		base *= texture(u_BaseMap, uv).rgb;
	}
    FragColor = vec4(base, 1.0);
}
